# Supabase URL и anon key.
# Для облака: https://<project>.supabase.co
# Для self-hosted в Казахстане: URL вашего локального Supabase API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Секретный ключ используется ТОЛЬКО серверным API-роутером.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Секрет для HMAC-хеширования API-ключей.
# Сгенерируйте: openssl rand -hex 32
API_KEY_HASH_PEPPER=replace-with-a-long-random-secret

# URL приложения нужен для GitHub OAuth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# LiteLLM Proxy: единая точка маршрутизации дополнительных моделей.
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-replace-with-long-random-master-key
LITELLM_CONFIG_FILE=./litellm/config.yaml

# Ключи провайдеров используются контейнером LiteLLM, а не Next.js напрямую.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key

# Upstream-модели задаются полным LiteLLM-идентификатором.
KZ_GPT_UPSTREAM_MODEL=openai/gpt-5.5
KZ_CLAUDE_UPSTREAM_MODEL=anthropic/claude-sonnet-4-5
KZ_QWEN_UPSTREAM_MODEL=openrouter/qwen/qwen3-235b-a22b
KZ_LLAMA_UPSTREAM_MODEL=groq/llama-3.3-70b-versatile

# Локальный сканер PII. В strict-режиме его недоступность блокирует запрос.
PII_SCANNER_URL=http://127.0.0.1:8001
PII_SCANNER_TOKEN=replace-with-a-long-random-scanner-token
PII_STRICT_MODE=true
PII_POLICY_VERSION=kz-pii-v2
PII_REQUIRED_ENGINE=gliner+regex-v2

# Необязательные настройки LiteLLM/Redis.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-redis-password

