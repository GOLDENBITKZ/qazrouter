# Скопируйте этот файл в .env.local для локальной разработки.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
API_KEY_HASH_PEPPER=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

DEEPSEEK_API_KEY=your-deepseek-api-key

GEMINI_API_KEY=your-gemini-api-key

LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-replace-with-long-random-master-key
LITELLM_CONFIG_FILE=./litellm/config.yaml

OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key

KZ_GPT_UPSTREAM_MODEL=openai/gpt-5.5
KZ_CLAUDE_UPSTREAM_MODEL=anthropic/claude-sonnet-4-5
KZ_QWEN_UPSTREAM_MODEL=openrouter/qwen/qwen3-235b-a22b
KZ_LLAMA_UPSTREAM_MODEL=groq/llama-3.3-70b-versatile

PII_SCANNER_URL=http://127.0.0.1:8001
PII_SCANNER_TOKEN=replace-with-a-long-random-scanner-token
PII_STRICT_MODE=true
PII_POLICY_VERSION=kz-pii-v2
PII_REQUIRED_ENGINE=gliner+regex-v2

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-redis-password
